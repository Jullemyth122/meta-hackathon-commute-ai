{
  "name": "commuteai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GPS-anchored digital twin of Philippine jeepney transport (Three.js + R3F, WebGPU).",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --mode phone --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "route:fetch": "node scripts/fetch-route.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@mapbox/vector-tile": "^3.0.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "earcut": "^3.2.4",
    "firebase": "^13.1.0",
    "gsap": "^3.15.0",
    "pbf": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
